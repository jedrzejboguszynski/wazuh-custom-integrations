<!-- Supress default Wazuh MS Graph API rules chain -->
<group name="ms-graph,">
  <rule id="99500" level="0" overwrite="yes">
    <decoded_as>json-msgraph</decoded_as>
    <field name="integration">disabled-by-local-override</field>
    <description>MS Graph: built-in chain disabled, see local rules 100900+.</description>
  </rule>
</group>

<!-- Defender incidents mapping ruleset -->
<group name="ms-graph,defender,">

  <rule id="100910" level="0">
    <decoded_as>json-msgraph</decoded_as>
    <field name="ms-graph.relationship">incidents</field>
    <description>MS Graph: Defender XDR incident (base rule).</description>
  </rule>

  <rule id="100911" level="12">
    <if_sid>100910</if_sid>
    <field name="ms-graph.severity">^high$</field>
    <description>Defender XDR HIGH incident: $(ms-graph.displayName)</description>
  </rule>

  <rule id="100912" level="8">
    <if_sid>100910</if_sid>
    <field name="ms-graph.severity">^medium$</field>
    <description>Defender XDR MEDIUM incident: $(ms-graph.displayName)</description>
  </rule>

  <rule id="100913" level="4">
    <if_sid>100910</if_sid>
    <field name="ms-graph.severity">^low$</field>
    <description>Defender XDR LOW incident: $(ms-graph.displayName)</description>
  </rule>

</group>
